rules_version = '2';

// Photos, video and voice notes. Everything lives under the trip it belongs to: trips/{tripId}/...
// Who may do what is decided by the trip's `members` map in Firestore (see firestore.rules), so sharing a trip shares its media.
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }
    function role(tripId) {
      return firestore.get(/databases/(default)/documents/trips/$(tripId)).data.members.get(request.auth.uid, null);
    }

    match /trips/{tripId}/{allPaths=**} {
      allow read: if signedIn() && role(tripId) != null;

      // Editors and owners add or replace files: images, video and audio only, up to 30 MB each.
      allow create, update: if signedIn()
        && role(tripId) in ['owner', 'editor']
        && request.resource.size < 30 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|video/.*|audio/.*');

      allow delete: if signedIn() && role(tripId) in ['owner', 'editor'];
    }

    // Everything else is closed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
