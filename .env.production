# Production environment: Vercel Production (branch main). Used by `npm run build`.
# Stays on the mock backend until the Firebase project "wayfarer-prod" exists and has been verified in dev first.
VITE_APP_ENV=production
VITE_BACKEND=mock

# VITE_BACKEND=firebase
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=wayfarer-prod.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=wayfarer-prod
# VITE_FIREBASE_STORAGE_BUCKET=wayfarer-prod.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
