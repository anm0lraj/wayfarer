rules_version = '2';

// Wayfarer data access. Layout and meaning: src/data/remote/paths.ts.
// A trip's `members` map (uid -> owner | editor | viewer) is the single source of truth for who may see or change it.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }

    // ---- profile and private collections: only the person themselves -------------------------------------------
    match /users/{userId} {
      allow read, write: if signedIn() && me() == userId;

      match /{collection}/{docId} {
        // Likes and saves of published trips have their own rules below; everything else here is private to the person.
        allow read, write: if signedIn() && me() == userId && !(collection in ['likedTrips', 'savedTrips', 'usage']);
      }

      // The assistant's daily allowance (written by the AI function with the person's own token). The count can only go
      // up, by at most one request's worth at a time, and the record can't be deleted, so it can't be reset for more.
      match /usage/{day} {
        allow read: if signedIn() && me() == userId;
        allow create: if signedIn() && me() == userId
          && day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && request.resource.data.keys().hasOnly(['count'])
          && request.resource.data.count is int && request.resource.data.count >= 1 && request.resource.data.count <= 3;
        allow update: if signedIn() && me() == userId
          && request.resource.data.keys().hasOnly(['count'])
          && request.resource.data.count is int
          && request.resource.data.count > resource.data.count && request.resource.data.count <= resource.data.count + 3;
        allow delete: if false;
      }

      // A like or save of a published trip must change that trip's counter by exactly one, in the same write, so the
      // counts cannot be inflated or drifted. The document id says whose it is and which trip: lk_/sv_ + uid + _ + trip.
      match /likedTrips/{docId} {
        allow read: if signedIn() && me() == userId;
        allow create: if signedIn() && me() == userId
          && docId == 'lk_' + me() + '_' + request.resource.data.publicTripId
          && counterMoves(request.resource.data.publicTripId, 'likeCount', 1);
        allow delete: if signedIn() && me() == userId
          && (!pubExists(resource.data.publicTripId) || counterMoves(resource.data.publicTripId, 'likeCount', -1));
      }

      match /savedTrips/{docId} {
        allow read: if signedIn() && me() == userId;
        // Saving one of your own trips (no published trip involved) is just a private note.
        allow create: if signedIn() && me() == userId
          && (!('publicTripId' in request.resource.data)
              || (docId == 'sv_' + me() + '_' + request.resource.data.publicTripId
                  && counterMoves(request.resource.data.publicTripId, 'saveCount', 1)));
        allow delete: if signedIn() && me() == userId
          && (!('publicTripId' in resource.data) || !pubExists(resource.data.publicTripId)
              || counterMoves(resource.data.publicTripId, 'saveCount', -1));
      }
    }

    function pubPath(pubId) { return /databases/$(database)/documents/publicTrips/$(pubId); }
    function pubExists(pubId) { return exists(pubPath(pubId)); }
    // The published trip's counter after this write is its counter before, plus delta.
    function counterMoves(pubId, field, delta) {
      return pubExists(pubId) && getAfter(pubPath(pubId)).data[field] == get(pubPath(pubId)).data[field] + delta;
    }

    // ---- trips ---------------------------------------------------------------------------------------------------
    function roleOf(members) { return members.get(me(), null); }
    function tripRole(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId)).data.members.get(me(), null);
    }

    function inTrip(collection) {
      return collection in ['days', 'items', 'bookings', 'checklist', 'memories', 'stories', 'collaborators', 'media'];
    }

    // Photos and voice notes are stored as documents; keep them within Firestore's 1 MiB document limit and to media types.
    function validMedia(collection, data) {
      return collection != 'media' || (data.data.size() <= 900000 && data.mime.matches('image/.*|audio/.*'));
    }

    // ---- invitations ---------------------------------------------------------------------------------------------
    // One document per (trip, email): invites/{tripId}__{email}. The owner writes it; the person with that verified email
    // can accept it, which is what lets them add themselves to the trip's members (and only with the role offered).
    function myEmail() { return request.auth.token.email.lower(); }
    function emailVerified() { return request.auth.token.email_verified == true; }
    function inviteDoc(tripId) {
      return get(/databases/$(database)/documents/invites/$(tripId + '__' + myEmail())).data;
    }
    function acceptingInvite(tripId) {
      return emailVerified()
        && inviteDoc(tripId).status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([me()])
        && request.resource.data.members[me()] == inviteDoc(tripId).role;
    }

    match /trips/{tripId} {
      // Reading an id that does not exist yet is how the app checks before creating; there is nothing to reveal.
      allow read: if signedIn() && (resource == null || roleOf(resource.data.members) != null);

      // A new trip is owned by whoever creates it, and by nobody else.
      allow create: if signedIn()
        && request.resource.data.ownerId == me()
        && request.resource.data.members.keys().hasOnly([me()])
        && request.resource.data.members[me()] == 'owner';

      // Owners can change anything except who owns it. Editors can change the trip but not who has access to it.
      allow update: if signedIn()
        && request.resource.data.ownerId == resource.data.ownerId
        && (
          (roleOf(resource.data.members) == 'owner' && request.resource.data.members[resource.data.ownerId] == 'owner')
          || (roleOf(resource.data.members) == 'editor' && request.resource.data.members == resource.data.members)
          || acceptingInvite(tripId)
        );

      allow delete: if signedIn() && roleOf(resource.data.members) == 'owner';

      // Everything inside a trip. Documents must say which trip they belong to, matching where they are stored.
      match /{collection}/{docId} {
        allow read: if signedIn() && inTrip(collection) && tripRole(tripId) != null;

        allow create, update: if signedIn()
          && inTrip(collection)
          && request.resource.data.tripId == tripId
          && validMedia(collection, request.resource.data)
          && (
            collection == 'collaborators'
              // The owner manages the list; a member may write only their own entry, at the role they were given.
              ? (tripRole(tripId) == 'owner' || (request.resource.data.userId == me() && request.resource.data.role == tripRole(tripId)))
              : tripRole(tripId) in ['owner', 'editor']
          );

        allow delete: if signedIn()
          && inTrip(collection)
          && (
            collection == 'collaborators'
              ? tripRole(tripId) == 'owner'
              : tripRole(tripId) in ['owner', 'editor']
          );
      }
    }

    match /invites/{inviteId} {
      function tripOf(tripId) { return get(/databases/$(database)/documents/trips/$(tripId)).data; }

      // Written so list queries can be checked against their filters: the invited person queries by their own email,
      // the inviting owner by their own uid. (Emails are stored lower-case, as Google returns them.)
      allow read: if signedIn() && (
        (emailVerified() && resource.data.email == request.auth.token.email)
        || resource.data.invitedBy == me()
      );

      allow create: if signedIn()
        && tripOf(request.resource.data.tripId).members.get(me(), null) == 'owner'
        && inviteId == request.resource.data.tripId + '__' + request.resource.data.email
        && request.resource.data.email == request.resource.data.email.lower()
        && request.resource.data.status == 'pending'
        && request.resource.data.role in ['editor', 'viewer']
        && request.resource.data.invitedBy == me();

      // The invited person can only answer it. The owner can change the role offered, but not who or what it is for.
      allow update: if signedIn() && (
        (tripOf(resource.data.tripId).members.get(me(), null) == 'owner'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'status'])
          && request.resource.data.role in ['editor', 'viewer']
          && request.resource.data.status in [resource.data.status, 'pending']) // only the invitee can accept or decline
        || (emailVerified() && resource.data.email == myEmail()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status in ['accepted', 'declined'])
      );

      allow delete: if signedIn() && (
        tripOf(resource.data.tripId).members.get(me(), null) == 'owner'
        || (emailVerified() && resource.data.email == myEmail())
      );
    }

    // ---- published trips ------------------------------------------------------------------------------------------
    // Anyone with a trip's id can open it, signed in or not; only `public` ones can be listed (queries must say so).
    // Anyone signed in may like or save, which moves one counter by one; only the publisher changes anything else.
    function onlyChanges(field) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([field]);
    }
    function likeDoc(pubId) { return /databases/$(database)/documents/users/$(me())/likedTrips/$('lk_' + me() + '_' + pubId); }
    function saveDoc(pubId) { return /databases/$(database)/documents/users/$(me())/savedTrips/$('sv_' + me() + '_' + pubId); }
    function bump(pubId, field, doc) {
      return onlyChanges(field) && (
        (request.resource.data[field] == resource.data[field] + 1 && !exists(doc) && existsAfter(doc))
        || (request.resource.data[field] == resource.data[field] - 1 && exists(doc) && !existsAfter(doc))
      );
    }

    // What a published page may contain: only the fields the app defines, in sensible sizes. (Rules cannot look inside each
    // list entry, so the app also drops unknown fields when it reads a page; see data/remote/publicTrips.ts.)
    function validPublicTrip(d) {
      return d.keys().hasOnly(['id', 'slug', 'tripId', 'ownerId', 'ownerName', 'visibility', 'title', 'description', 'coverImage',
                               'destinationIds', 'durationDays', 'budgetRange', 'travelStyle', 'tips', 'snapshot', 'likeCount', 'saveCount', 'publishedAt'])
        && d.visibility in ['link', 'public']
        && d.title is string && d.title.size() <= 200
        && d.description is string && d.description.size() <= 2000
        && d.coverImage is string && d.coverImage.size() <= 400000
        && d.tips.size() <= 8
        && d.destinationIds.size() <= 10
        && d.snapshot.keys().hasOnly(['days', 'items', 'places', 'memories'])
        && d.snapshot.days.size() <= 60 && d.snapshot.items.size() <= 500
        && d.snapshot.places.size() <= 300 && d.snapshot.memories.size() <= 100
        && d.likeCount is int && d.likeCount >= 0 && d.saveCount is int && d.saveCount >= 0;
    }

    match /publicTrips/{id} {
      allow get: if true;
      allow list: if resource.data.visibility == 'public';
      allow create: if signedIn() && request.resource.data.ownerId == me() && validPublicTrip(request.resource.data);
      allow update: if signedIn() && (
        (resource.data.ownerId == me() && request.resource.data.ownerId == me() && validPublicTrip(request.resource.data))
        || bump(id, 'likeCount', likeDoc(id))
        || bump(id, 'saveCount', saveDoc(id))
      );
      allow delete: if signedIn() && resource.data.ownerId == me();

      // Photos shown on the public page (copies of the publisher's trip photos), readable by anyone who can open the page.
      match /media/{mediaId} {
        allow read: if true;
        allow create, update: if signedIn()
          && get(/databases/$(database)/documents/publicTrips/$(id)).data.ownerId == me()
          && validMedia('media', request.resource.data);
        allow delete: if signedIn() && get(/databases/$(database)/documents/publicTrips/$(id)).data.ownerId == me();
      }
    }

    // Short links: slug -> published trip, so a page can be opened by its URL without being listed.
    match /publicSlugs/{slug} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn() && request.resource.data.ownerId == me();
      allow delete: if signedIn() && resource.data.ownerId == me();
      // Republishing writes the link again; only its owner may, and it cannot be handed to someone else.
      allow update: if signedIn() && resource.data.ownerId == me() && request.resource.data.ownerId == me();
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
