# Development environment: `npm run dev` and Vercel Preview deployments (branch stage-2-dev).
# Public values only (Firebase web config is public by design). Never put secrets in a VITE_ variable.
# Secrets belong in Vercel environment variables for the serverless functions, scoped per environment.
VITE_APP_ENV=development
VITE_BACKEND=mock
# Real forecasts (Open-Meteo) and road routes (OSRM demo server). No keys. Production stays on mock until launch.
VITE_WEATHER=live
VITE_ROUTING=live
# The real assistant (Gemini) needs a key set on the server side; leave on mock until GEMINI_API_KEY exists (see CLAUDE.md, M3).
# VITE_AI=live

# Switch to the real dev backend once the Firebase project "wayfarer-dev-c2efe" exists:
# VITE_BACKEND=firebase
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=wayfarer-dev-c2efe.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=wayfarer-dev-c2efe
# VITE_FIREBASE_STORAGE_BUCKET=wayfarer-dev-c2efe.firebasestorage.app
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
